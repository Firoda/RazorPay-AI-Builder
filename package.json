{
  "name": "seatsaver",
  "version": "1.0.0",
  "description": "SeatSaver: late-authorised payment booking rescue agent (Razorpay x ISB Build Challenge prototype)",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p story",
    "eval": "tsx eval/runEval.ts",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:story && npm run build:web",
    "prestart": "node scripts/ensure-build.mjs",
    "build:story": "vite build --config story/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:story": "vite --config story/vite.config.ts",
    "images": "node scripts/optimize-images.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firoda/RazorPay-AI-Builder.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Firoda/RazorPay-AI-Builder/issues"
  },
  "homepage": "https://github.com/Firoda/RazorPay-AI-Builder#readme",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.28.0",
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "driver.js": "^1.9.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
