{
  "name": "seatsaver",
  "version": "1.0.0",
  "description": "SeatSaver: late-authorised payment booking rescue agent (Razorpay x ISB Build Challenge prototype)",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "eval": "tsx eval/runEval.ts",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firoda/RazorPay-AI-Builder.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Firoda/RazorPay-AI-Builder/issues"
  },
  "homepage": "https://github.com/Firoda/RazorPay-AI-Builder#readme",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
