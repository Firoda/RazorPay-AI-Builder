# Copy to .env and fill in. Never commit .env. Empty values fall back to the defaults shown in comments.

# Gemini API key (Google AI Studio injects this automatically when hosted there).
GEMINI_API_KEY=
# Model(s). Default: gemini-3.8-flash only (cost decision). A comma list enables a fallback chain.
GEMINI_MODELS=gemini-3.8-flash
# Thinking level for Gemini 3.x: minimal | low | medium | high (lower = faster, cheaper). Default: low.
GEMINI_THINKING=low
# Per-call timeout in ms. Default: 120000.
GEMINI_TIMEOUT_MS=120000
# Minimum gap between Gemini calls in ms. Default: 4000.
GEMINI_MIN_INTERVAL_MS=500
# AI mode: gemini (live) | cache-only (demo-safe replay) | fake (offline stub). Default: gemini if a key is set, else fake.
AI_MODE=

# Razorpay TEST mode keys (Dashboard → Test mode → API Keys). Live keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Protects /api/demo/* on the hosted app. Set this on any public deployment.
DEMO_ADMIN_TOKEN=

# Port. AI Studio uses 3000; Cloud Run injects PORT automatically.
# PORT=3000
