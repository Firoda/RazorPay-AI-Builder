# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio → Get API key). Free tier works.
GEMINI_API_KEY=
# Comma-separated fallback chain. The free tier gives each model its own daily quota (currently 20 requests/day).
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Minimum gap between Gemini calls (ms) to stay under free-tier rate limits.
# Thinking level for Gemini 3.x: minimal | low | medium | high (lower = faster, cheaper).
GEMINI_THINKING=low
# Per-call timeout (ms).
GEMINI_TIMEOUT_MS=120000
GEMINI_MIN_INTERVAL_MS=4000

# AI mode: "gemini" (live), "cache-only" (demo-safe replay), or "fake" (offline deterministic stub).
AI_MODE=gemini

# Razorpay TEST mode keys (Dashboard → Test mode → API Keys). Never use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Protects /demo/* endpoints on the hosted app. Leave empty locally.
DEMO_ADMIN_TOKEN=

PORT=8080
