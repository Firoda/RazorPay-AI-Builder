# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio → Get API key). Free tier works.
GEMINI_API_KEY=
# Override if a newer free-tier Flash model is available in AI Studio.
GEMINI_MODEL=gemini-2.5-flash
# Minimum gap between Gemini calls (ms) to stay under free-tier rate limits.
GEMINI_MIN_INTERVAL_MS=4000

# AI mode: "gemini" (live), "cache-only" (demo-safe replay), or "fake" (offline deterministic stub).
AI_MODE=gemini

# Razorpay TEST mode keys (Dashboard → Test mode → API Keys). Never use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Protects /demo/* endpoints on the hosted app. Leave empty locally.
DEMO_ADMIN_TOKEN=

PORT=8080
